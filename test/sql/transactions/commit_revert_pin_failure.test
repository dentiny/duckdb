# name: test/sql/transactions/commit_revert_pin_failure.test
# description: Test RevertCommit behavior when Pin throws during undo buffer iteration under memory pressure
# group: [transactions]

require no_alternative_verify

require skip_reload

statement ok
SET preserve_insertion_order = false;

statement ok
SET threads = 1;

statement ok
SET temp_directory = '{TEST_DIR}/tmp_undo_pin_failure';

statement ok
SET memory_limit = '4MB';

statement ok
CREATE TABLE t (id INT, s VARCHAR);

statement ok
INSERT INTO t SELECT range, repeat('a', 100) FROM range(5000);

statement ok
BEGIN TRANSACTION;

statement ok
UPDATE t SET s = repeat('b', 100);

statement ok
SET memory_limit = '1.5MB';

statement error
COMMIT;
----
failed to pin block

statement ok
SET memory_limit = '10MB';

query I
SELECT count(*) FROM t;
----
5000

query I
SELECT count(*) FROM t WHERE s = repeat('a', 100);
----
5000
