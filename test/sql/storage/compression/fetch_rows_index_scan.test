# name: test/sql/storage/compression/fetch_rows_index_scan.test
# description: Test fetching many rows of compressed string segments through an index scan
# group: [compression]

load __TEST_DIR__/fetch_rows_index_scan.db

statement ok
SET dynamic_or_filter_threshold = 1000;

statement ok
SET disabled_optimizers = 'compressed_materialization';

statement ok
SET force_compression = 'dict_fsst';

# rows are inserted in shuffled order, so the row ids of an id lookup are not sorted
statement ok
CREATE TABLE t_dict (id INTEGER PRIMARY KEY, c VARCHAR);

statement ok
INSERT INTO t_dict SELECT i, CASE WHEN i % 7 = 0 THEN NULL ELSE 'value_' || (i % 50) END
FROM range(1, 50001) r(i) ORDER BY hash(i);

statement ok
CREATE TABLE t_dict_long (id INTEGER PRIMARY KEY, c VARCHAR);

statement ok
INSERT INTO t_dict_long SELECT i, CASE WHEN i % 11 = 0 THEN NULL ELSE 'a longer string that is not inlined ' || (i % 5000) END
FROM range(1, 50001) r(i) ORDER BY hash(i);

statement ok
CREATE TABLE t_unique (id INTEGER PRIMARY KEY, c VARCHAR);

statement ok
INSERT INTO t_unique SELECT i, md5(i::VARCHAR) FROM range(1, 50001) r(i) ORDER BY hash(i);

statement ok
CHECKPOINT

statement ok
SET force_compression = 'zstd';

statement ok
CREATE TABLE t_zstd (id INTEGER PRIMARY KEY, c VARCHAR);

statement ok
INSERT INTO t_zstd SELECT i, CASE WHEN i % 9 = 0 THEN NULL ELSE repeat(md5(i::VARCHAR), 4) END
FROM range(1, 50001) r(i) ORDER BY hash(i);

statement ok
CHECKPOINT

statement ok
SET force_compression = 'auto';

query II
SELECT DISTINCT 't_dict', split_part(segment_info, ':', 1) FROM pragma_storage_info('t_dict', include_segment_info=true) WHERE segment_type = 'VARCHAR'
UNION ALL
SELECT DISTINCT 't_dict_long', split_part(segment_info, ':', 1) FROM pragma_storage_info('t_dict_long', include_segment_info=true) WHERE segment_type = 'VARCHAR'
UNION ALL
SELECT DISTINCT 't_unique', split_part(segment_info, ':', 1) FROM pragma_storage_info('t_unique', include_segment_info=true) WHERE segment_type = 'VARCHAR'
UNION ALL
SELECT DISTINCT 't_zstd', compression FROM pragma_storage_info('t_zstd') WHERE segment_type = 'VARCHAR'
ORDER BY ALL
----
t_dict	DICTIONARY
t_dict_long	DICT_FSST
t_unique	DICTIONARY
t_unique	FSST_ONLY
t_zstd	ZSTD

# committed updates must be applied on top of the fetched values
foreach table t_dict t_dict_long t_unique t_zstd

statement ok
UPDATE {table} SET c = 'updated ' || id WHERE id IN (16, 3874, 25000);

endloop

statement ok
CREATE TABLE keys AS SELECT DISTINCT (i * 7919) % 50000 + 1 AS id FROM range(800) r(i)
UNION ALL SELECT * FROM (VALUES (1), (2), (3), (16), (3874), (25000), (49999), (50000));

statement ok
CREATE TABLE clustered_keys AS SELECT i AS id FROM range(20000, 21200, 2) r(i);

foreach table t_dict t_dict_long t_unique t_zstd

foreach key_table keys clustered_keys

statement ok
SET index_scan_max_count = 100000;

query II
EXPLAIN ANALYZE SELECT t.id, t.c FROM {table} t JOIN {key_table} USING (id)
----
analyzed_plan	<REGEX>:.*Type: Index Scan.*

statement ok
CREATE OR REPLACE TEMP TABLE index_result AS SELECT t.id, t.c FROM {table} t JOIN {key_table} USING (id)

statement ok
SET index_scan_max_count = 0;

statement ok
SET index_scan_percentage = 0;

query II
EXPLAIN ANALYZE SELECT t.id, t.c FROM {table} t JOIN {key_table} USING (id)
----
analyzed_plan	<!REGEX>:.*Type: Index Scan.*

statement ok
CREATE OR REPLACE TEMP TABLE scan_result AS SELECT t.id, t.c FROM {table} t JOIN {key_table} USING (id)

query III
SELECT (SELECT count(*) FROM index_result) IN (600, 808),
       (SELECT count(*) FROM (FROM index_result EXCEPT ALL FROM scan_result)),
       (SELECT count(*) FROM (FROM scan_result EXCEPT ALL FROM index_result))
----
true	0	0

statement ok
RESET index_scan_percentage;

endloop

endloop

query II
SELECT id, c FROM t_zstd WHERE id IN (3874, 25000, 9, 10) ORDER BY id
----
9	NULL
10	d3d9446802a44259755d38e6d163e820d3d9446802a44259755d38e6d163e820d3d9446802a44259755d38e6d163e820d3d9446802a44259755d38e6d163e820
3874	updated 3874
25000	updated 25000
