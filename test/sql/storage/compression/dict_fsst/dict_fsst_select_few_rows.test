# name: test/sql/storage/compression/dict_fsst/dict_fsst_select_few_rows.test
# description: Selects of a few rows decode just those rows until they add up to the dictionary size
# group: [dict_fsst]

load {TEST_DIR}/dict_fsst_select_few_rows.db

statement ok
SET force_compression='uncompressed';

# fsst: a large FSST-encoded dictionary, low: a 10 entry dictionary, short: a plain dictionary, all with NULLs
statement ok
CREATE TABLE uncompressed_data AS
SELECT i,
	CASE WHEN i % 101 = 0 THEN NULL ELSE 'customer-' || (hash(i) % 20000) || '@example.com' END AS fsst,
	CASE WHEN i % 103 = 0 THEN NULL ELSE 'category_' || (i % 10) END AS low,
	CASE WHEN i % 107 = 0 THEN NULL ELSE chr(97 + (i % 7)::INTEGER) END AS short
FROM range(300000) t(i);

statement ok
SET force_compression='dict_fsst';

statement ok
CREATE TABLE compressed_data AS SELECT * FROM uncompressed_data;

statement ok
CHECKPOINT;

restart

query I
SELECT DISTINCT compression FROM pragma_storage_info('compressed_data') WHERE segment_type = 'VARCHAR';
----
DICT_FSST

foreach table uncompressed_data compressed_data

# a single row
query IIII nosort single_row
SELECT * FROM {table} WHERE i = 123457;
----

# a NULL in every column but the first
query IIII nosort null_rows
SELECT * FROM {table} WHERE i IN (101 * 103, 101 * 107, 103 * 107) ORDER BY i;
----

# a few rows of one vector
query IIII nosort few_rows
SELECT * FROM {table} WHERE i BETWEEN 200000 AND 200030 AND i % 3 = 0 ORDER BY i;
----

# a few rows in every vector: decoded one by one until the dictionary is cheaper
query IIII nosort sparse_rows
SELECT * FROM {table} WHERE i % 97 = 5 ORDER BY i;
----

query III nosort sparse_aggregate
SELECT count(DISTINCT fsst), count(DISTINCT low), count(DISTINCT short) FROM {table} WHERE i % 89 = 1;
----

# many rows of every vector, which still use the dictionary
query III nosort dense_aggregate
SELECT count(DISTINCT fsst), count(DISTINCT low), count(DISTINCT short) FROM {table} WHERE i % 3 = 1;
----

endloop

query I
SELECT count(*) FROM compressed_data c JOIN uncompressed_data u USING (i)
WHERE c.fsst IS DISTINCT FROM u.fsst OR c.low IS DISTINCT FROM u.low OR c.short IS DISTINCT FROM u.short;
----
0
