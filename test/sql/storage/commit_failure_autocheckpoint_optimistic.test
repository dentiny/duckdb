# name: test/sql/storage/commit_failure_autocheckpoint_optimistic.test
# description: An autocheckpoint failure preserves committed optimistic data for WAL recovery
# group: [storage]

require no_alternative_verify

require noforcestorage

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET threads = 1;

statement ok
SET enable_optimistic_write = true;

statement ok
SET write_buffer_row_group_count = 1;

statement ok
SET auto_checkpoint_skip_wal_threshold = 9999999999;

statement ok
ATTACH '{TEST_DIR}/commit_failure_autocheckpoint_optimistic.db' AS db;

statement ok
CREATE TABLE db.t(i INTEGER, payload VARCHAR);

statement ok
CHECKPOINT db;

statement ok
BEGIN;

statement ok
INSERT INTO db.t SELECT i, md5(i::VARCHAR) FROM range(200000) AS r(i);

query I
SELECT used_blocks > 5 FROM pragma_database_size() WHERE database_name = 'db';
----
true

statement ok
SET debug_skip_checkpoint_on_commit = false;

statement ok
SET wal_autocheckpoint = '1B';

statement ok
PRAGMA debug_checkpoint_abort = 'before_header_non_fatal';

# The WAL commit succeeds before the injected checkpoint error.
statement error
COMMIT;
----
<REGEX>:.*Transaction COMMIT succeeded.*autocheckpoint failed.*Checkpoint aborted before header write.*

statement error
SELECT count(*) FROM db.t;
----
has been invalidated

statement ok
PRAGMA debug_checkpoint_abort = 'none';

statement ok
SET wal_autocheckpoint = '1TB';

statement ok
DETACH db;

statement ok
ATTACH '{TEST_DIR}/commit_failure_autocheckpoint_optimistic.db' AS db;

# Recovery must retain the committed rows and their payload blocks.
query III
SELECT count(*), sum(i), count(*) FILTER (WHERE payload <> md5(i::VARCHAR)) FROM db.t;
----
200000	19999900000	0

statement ok
SET debug_verify_blocks = true;

statement ok
CHECKPOINT db;

statement ok
DETACH db;
