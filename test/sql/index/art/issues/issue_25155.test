# name: test/sql/index/art/issues/issue_25155.test
# description: Issue #25155: IN combined with IS NOT DISTINCT FROM in an ART index scan
# group: [issues]

statement ok
SET index_scan_percentage = 1.0;

statement ok
CREATE TABLE t(a INTEGER, p INTEGER);

statement ok
INSERT INTO t VALUES (1, 10), (3, 30);

statement ok
CREATE INDEX t_a ON t(a);

query I
SELECT p
FROM t
WHERE a IN (1, 3)
  AND a IS NOT DISTINCT FROM 1
ORDER BY p;
----
10

query I
SELECT p
FROM t
WHERE a IN (1, 3)
  AND a IS DISTINCT FROM 1
ORDER BY p;
----
30
