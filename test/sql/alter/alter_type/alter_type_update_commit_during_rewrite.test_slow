# name: test/sql/alter/alter_type/alter_type_update_commit_during_rewrite.test_slow
# description: An UPDATE that commits during an ALTER TYPE rewrite must not be dropped
# group: [alter_type]

# ALTER TYPE rewrites the column and does not inherit update segments. A concurrent
# UPDATE COMMIT can succeed while the rewrite is in flight and then vanish.
# log is written in the same transaction: after both threads join, either v = 7 or
# the commit failed and log is empty. (v = 0 AND log count = 1) is the bug.

statement ok
SET threads=1

loop delay 0 6

statement ok
DROP TABLE IF EXISTS t

statement ok
DROP TABLE IF EXISTS log

statement ok
CREATE TABLE t(id INTEGER, v INTEGER)

statement ok
CREATE TABLE log(msg VARCHAR)

statement ok
INSERT INTO t SELECT i::INT, 0 FROM range(1500000) tbl(i)

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
BEGIN

onlyif threadid=0
statement ok
UPDATE t SET v = 7 WHERE id = 1

onlyif threadid=0
statement ok
INSERT INTO log VALUES ('committed')

onlyif threadid=0
statement ok
SELECT sleep_ms({delay} + 3)

# may conflict if the rewrite has already marked the table altered
onlyif threadid=0
statement maybe
COMMIT
----
TransactionContext Error

onlyif threadid=1
statement ok
SELECT sleep_ms(2)

onlyif threadid=1
statement ok
ALTER TABLE t ALTER COLUMN v SET DATA TYPE BIGINT

endloop

query I
SELECT CASE
	WHEN (SELECT count(*) FROM log) = 0 THEN 1
	WHEN (SELECT v FROM t WHERE id = 1) = 7 THEN 1
	ELSE 0
END
----
1

endloop
