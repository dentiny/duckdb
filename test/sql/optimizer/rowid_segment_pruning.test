# name: test/sql/optimizer/rowid_segment_pruning.test
# description: Vector-level pruning for rowid filters inside a row group
# group: [optimizer]

require json

require vector_size 2048

statement ok
CREATE TABLE t AS SELECT i FROM range(100000) t(i)

statement ok
PRAGMA enable_profiling = 'json'

statement ok
PRAGMA profiling_output = '{TEST_DIR}/rowid_segment_profile.json'

statement ok
SET tracked_metrics = ['query.total_rows_scanned']

query I
SELECT count(*) FROM t WHERE rowid >= 99999
----
1

statement ok
PRAGMA disable_profiling

# Last vector is [98304, 100000). Without vector skip this is 100000.
query I
SELECT query.total_rows_scanned
FROM '{TEST_DIR}/rowid_segment_profile.json'
----
1696
