# name: test/sql/optimizer/regex_range_row_group_pruning.test
# description: The range of strings a full regular-expression match can accept is used to prune row groups
# group: [optimizer]

require parquet

statement ok
ATTACH '{TEST_DIR}/regex_range_prune.duckdb' AS db (ROW_GROUP_SIZE 2048);

statement ok
USE db;

# sorted strings k00000 .. k10239 -> 5 row groups of 2048 rows each
statement ok
CREATE TABLE strs AS SELECT 'k' || lpad(range::VARCHAR, 5, '0') AS s FROM range(10240);

statement ok
COPY strs TO '{TEST_DIR}/regex_range_prune.parquet' (ROW_GROUP_SIZE 2048);

# k05000 .. k05999 all lie in the third row group, both bounds are needed to prune the others
query II
EXPLAIN ANALYZE SELECT count(*) FROM strs WHERE s SIMILAR TO 'k05.*';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 5.*

query II
EXPLAIN ANALYZE SELECT count(*) FROM '{TEST_DIR}/regex_range_prune.parquet' WHERE s SIMILAR TO 'k05.*';
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 5.*

query I
SELECT count(*) FROM strs WHERE s SIMILAR TO 'k05.*';
----
1000

# the bounds are only used for pruning, the match itself is still evaluated
query I
SELECT count(*) FROM strs WHERE s SIMILAR TO 'k1.*9';
----
24
