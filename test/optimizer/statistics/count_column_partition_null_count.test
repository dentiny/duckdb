# name: test/optimizer/statistics/count_column_partition_null_count.test
# description: count(col) on a nullable column folds via per-row-group null_count metadata
# group: [statistics]

require parquet

statement ok
COPY (
  SELECT CASE WHEN i < 50000 THEN NULL ELSE i::INTEGER END AS x
  FROM range(0, 100000) tbl(i)
) TO '{TEST_DIR}/count_null_stats.parquet' (FORMAT PARQUET, ROW_GROUP_SIZE 10000);

# The whole aggregate should be replaced with a constant; no parquet scan in the physical plan.
statement ok
PRAGMA explain_output = 'PHYSICAL_ONLY';

query II
EXPLAIN SELECT count(x) FROM '{TEST_DIR}/count_null_stats.parquet';
----
physical_plan	<!REGEX>:.*PARQUET_SCAN.*

query II
SELECT count(*), count(x) FROM '{TEST_DIR}/count_null_stats.parquet';
----
100000	50000
